[Unit]
Description=Orion Central (painel, API e runner do Claude) — roda como danilo, dono do login do Max
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=danilo
Group=orion
WorkingDirectory=/srv/orion-live
Environment=ORION_REPO=/srv/orion
EnvironmentFile=/etc/orion/central.env
ExecStart=/usr/bin/node /srv/orion-live/dist/server/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
