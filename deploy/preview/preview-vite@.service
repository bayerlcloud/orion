[Unit]
Description=Orion: vite dev do preview %i
StopWhenUnneeded=yes

[Service]
User=preview
Slice=preview.slice
MemoryMax=600M
EnvironmentFile=/srv/previews/%i.env
Environment=NODE_ENV=development
ExecStart=/bin/sh -c 'cd "$PREVIEW_DIR" && exec node_modules/.bin/vite --host 127.0.0.1 --port "$VITE_PORT" --strictPort'
ExecStartPost=/bin/sh -c 'for i in $(seq 240); do nc -z 127.0.0.1 "$VITE_PORT" && exit 0; sleep 0.5; done; exit 1'
TimeoutStartSec=150
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
# Leitura das pastas e escrita só em node_modules/.vite vêm das ACLs do usuário preview
# (deploy/preview/instalar.sh e liberarCache em server/preview/pasta.ts).
